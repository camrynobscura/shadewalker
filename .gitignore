# Data is regenerable from the pipeline and never committed. The committed
# pilot test fixture lives in tests/fixtures/, not here: the server loads
# every export it finds in data/export/, so nothing the tests depend on may
# sit beside the real one.
data/*

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets — uv auto-loads this at run time; never commit it (SOCRATA_APP_TOKEN)
.env

# Frontend
node_modules/
web/dist/

# macOS
.DS_Store

# Editor: VS Code's Markdown Preview Enhanced writes its config here
.crossnote/
