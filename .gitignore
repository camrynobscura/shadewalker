# Data is regenerable from the pipeline — never committed (can be 100s of MB
# citywide). The committed pilot test fixture lives in tests/fixtures/, NOT
# here — data/tiles/ must hold only real production tiles, so nothing the
# tests depend on ever loads into the production server by accident.
data/*

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets — uv auto-loads this at run time; never commit it (SOCRATA_APP_TOKEN)
.env

# Frontend (arrives in M4)
node_modules/
web/dist/

# macOS
.DS_Store

# Claude Code local (per-machine) state — settings, plans, scheduled-task locks
.claude/

# Every CLAUDE.md, at any depth — deliberately NOT anchored with a leading
# slash, so nested per-area ones (web/CLAUDE.md, and any future server/ or
# pipeline/ equivalent) are covered automatically without editing this file.
# Don't narrow this to /CLAUDE.md.
CLAUDE.md

# Personal project plan/notes — not shared. HISTORY.md is an index into
# history/, which holds the split-out parts (see HISTORY.md's own map) —
# ignore the whole directory, not individual files, so new parts are covered
# without editing this.
PLAN.md
HISTORY.md
history/
