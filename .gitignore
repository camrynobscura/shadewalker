# Data is regenerable from the pipeline — never committed (can be 100s of MB
# citywide), except the small pilot tile below: pytest and Playwright's
# webServer both load it at test time, and CI has no pipeline/live-API
# access to regenerate it, so a committed copy is its test fixture.
data/*
!data/tiles/
data/tiles/*
!data/tiles/pilot.json.gz

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets — uv auto-loads this at run time; never commit it (SOCRATA_APP_TOKEN)
.env

# Frontend (arrives in M4)
node_modules/
web/dist/

# macOS
.DS_Store

# Claude Code local (per-machine) state — settings, plans, scheduled-task locks
.claude/
CLAUDE.md

# Personal project plan/notes — not shared
PLAN.md
HISTORY.md
