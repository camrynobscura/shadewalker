# systemd unit — Shade Walker routing/app server (uvicorn).
#
# Install:
#   sudo cp deploy/shadewalker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now shadewalker
#
# Runs uvicorn straight from the slim venv that `uv sync --no-default-groups`
# builds — no `uv` needed at runtime. ONE worker on purpose: routes
# serialize through igraph/the GIL anyway (measured 2026-08-30), and each
# extra worker costs ~0.7GB RAM; a worker bump is a deliberate RAM
# decision, not a default.

[Unit]
Description=Shade Walker routing + app server (uvicorn)
After=network-online.target
Wants=network-online.target

# Give up rather than loop: with Restart=always, a start that keeps dying
# (e.g. OOM-killed) would otherwise retry forever and can freeze the
# whole droplet. Three tries in 10 minutes, then the
# unit parks itself failed and `systemctl status shadewalker` says why.
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=exec
User=shadewalker
Group=shadewalker
WorkingDirectory=/opt/shadewalker

# --no-access-log: uvicorn's access log ties a visitor's IP to their
#   searched text (/geocode?q=) and route coordinates — privacy.
#   App-level logs (startup, warnings) still go to journald.
# --no-server-header: don't advertise the stack.
# Bind to localhost only — Caddy is the sole public entry point.
ExecStart=/opt/shadewalker/.venv/bin/uvicorn server.app:app \
    --host 127.0.0.1 --port 8000 \
    --no-access-log --no-server-header

Restart=always
RestartSec=3

# Memory guard — the box has 2GB total and no swap. A normal start peaks
# ~0.73GB (measured on the box 2026-09-26); a runaway start once passed
# 1.77GB and thrashed the whole droplet unresponsive for 8+ minutes before
# the kernel OOM killer fired. The cap converts any such runaway into a
# clean kill of THIS unit the moment it crosses 1.7GB; MemoryHigh starts
# reclaiming/throttling it before that. Raise both only with a bigger box.
MemoryHigh=1500M
MemoryMax=1700M

# When you self-host Photon later, point the proxy at it here (default is
# the public komoot instance) — nothing else moves:
# Environment=SHADEWALKER_PHOTON_URL=http://127.0.0.1:2322

# Hardening. The service only reads its own tree — it writes nothing,
# so no ReadWritePaths at all:
# ProtectSystem=strict leaves the whole filesystem read-only to it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# No devices, kernel settings, clock, hostname, namespaces or special
# privileges: a server that reads files and speaks HTTP needs none of them.
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
CapabilityBoundingSet=
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
RemoveIPC=true
UMask=0077

# Internet sockets for Caddy on localhost and the outbound geocoder calls,
# plus Unix sockets, which reach nothing off the box.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Only the system calls an ordinary service makes; a blocked call fails
# with EPERM instead of killing the process. No memory that is both
# writable and executable.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
MemoryDenyWriteExecute=true

# Other processes and most of /proc hidden, and a private user mapping.
ProtectProc=invisible
ProcSubset=pid
PrivateUsers=true

# `systemd-analyze security shadewalker`: 8.3 before the settings above,
# 1.1 after (systemd 255, measured on the box 2026-10-01). What still
# counts is the network the app needs (Caddy reaches it on localhost; it
# calls the geocoder), and the read-only clock device ProtectClock allows,
# which PrivateDevices leaves out of /dev anyway.

[Install]
WantedBy=multi-user.target
